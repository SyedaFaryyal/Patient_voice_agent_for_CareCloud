[
  {
    "type": "function",
    "function": {
      "name": "check_existing_patient",
      "description": "Check whether a patient already exists by phone number, before registering a new one. Always call this first, right after the caller gives their phone number.",
      "parameters": {
        "type": "object",
        "properties": {
          "phone_number": { "type": "string", "description": "10-digit US phone number." }
        },
        "required": ["phone_number"]
      }
    },
    "server": { "url": "https://patientvoiceagentforcarecloud-production.up.railway.app/vapi/tool-call" }
  },
  {
    "type": "function",
    "function": {
      "name": "register_patient",
      "description": "Register a new patient after all required fields have been collected AND confirmed back to the caller. If this returns an 'Invalid value for X' message, re-ask the caller specifically for field X and call this tool again once corrected.",
      "parameters": {
        "type": "object",
        "properties": {
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "date_of_birth": { "type": "string", "description": "YYYY-MM-DD format." },
          "sex": { "type": "string", "enum": ["Male", "Female", "Other", "Decline to Answer"] },
          "phone_number": { "type": "string", "description": "10-digit US phone number." },
          "email": { "type": "string" },
          "address_line_1": { "type": "string" },
          "address_line_2": { "type": "string" },
          "city": { "type": "string" },
          "state": { "type": "string", "description": "2-letter US state abbreviation." },
          "zip_code": { "type": "string" },
          "insurance_provider": { "type": "string" },
          "insurance_member_id": { "type": "string" },
          "preferred_language": { "type": "string" },
          "emergency_contact_name": { "type": "string" },
          "emergency_contact_phone": { "type": "string" }
        },
        "required": ["first_name", "last_name", "date_of_birth", "sex", "phone_number",
                      "address_line_1", "city", "state", "zip_code"]
      }
    },
    "server": { "url": "https://patientvoiceagentforcarecloud-production.up.railway.app/vapi/tool-call" }
  },
  {
    "type": "function",
    "function": {
      "name": "update_patient",
      "description": "Update an existing patient's record. Use when check_existing_patient found a match and the caller wants to update their info instead of creating a new record.",
      "parameters": {
        "type": "object",
        "properties": {
          "patient_id": { "type": "string", "description": "The existing patient's ID, from check_existing_patient." },
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "date_of_birth": { "type": "string" },
          "sex": { "type": "string", "enum": ["Male", "Female", "Other", "Decline to Answer"] },
          "phone_number": { "type": "string" },
          "email": { "type": "string" },
          "address_line_1": { "type": "string" },
          "address_line_2": { "type": "string" },
          "city": { "type": "string" },
          "state": { "type": "string" },
          "zip_code": { "type": "string" },
          "insurance_provider": { "type": "string" },
          "insurance_member_id": { "type": "string" },
          "preferred_language": { "type": "string" },
          "emergency_contact_name": { "type": "string" },
          "emergency_contact_phone": { "type": "string" }
        },
        "required": ["patient_id"]
      }
    },
    "server": { "url": "https://patientvoiceagentforcarecloud-production.up.railway.app/vapi/tool-call" }
  }
]
